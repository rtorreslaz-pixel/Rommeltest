<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.rommel.scaleprototype.ui.LoginFragment"
        android:label="@string/title_login">
        <action
            android:id="@+id/action_login_to_captureSetup"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.rommel.scaleprototype.ui.HomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_home_to_captureSetup"
            app:destination="@id/captureSetupFragment" />
        <action
            android:id="@+id/action_home_to_sacaSetup"
            app:destination="@id/sacaSetupFragment" />
        <action
            android:id="@+id/action_home_to_planDia"
            app:destination="@id/planDiaFragment" />
    </fragment>

    <fragment
        android:id="@+id/planDiaFragment"
        android:name="com.rommel.scaleprototype.ui.PlanDiaFragment"
        android:label="@string/title_plan_dia">
        <action
            android:id="@+id/action_planDia_to_planItem"
            app:destination="@id/planItemFragment" />
        <action
            android:id="@+id/action_planDia_to_captureSetup"
            app:destination="@id/captureSetupFragment" />
    </fragment>

    <fragment
        android:id="@+id/planItemFragment"
        android:name="com.rommel.scaleprototype.ui.PlanItemFragment"
        android:label="@string/title_plan_item" />

    <fragment
        android:id="@+id/sacaSetupFragment"
        android:name="com.rommel.scaleprototype.ui.SacaSetupFragment"
        android:label="@string/title_saca_setup">
        <action
            android:id="@+id/action_sacaSetup_to_sacaCapture"
            app:destination="@id/sacaCaptureFragment" />
    </fragment>

    <fragment
        android:id="@+id/sacaCaptureFragment"
        android:name="com.rommel.scaleprototype.ui.SacaCaptureFragment"
        android:label="@string/title_saca_capture">
        <action
            android:id="@+id/action_sacaCapture_to_diagnostic"
            app:destination="@id/bluetoothDiagnosticFragment" />
        <action
            android:id="@+id/action_sacaCapture_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/captureSetupFragment"
        android:name="com.rommel.scaleprototype.ui.CaptureSetupFragment"
        android:label="@string/title_capture_setup">
        <action
            android:id="@+id/action_captureSetup_to_capture"
            app:destination="@id/captureFragment" />
        <action
            android:id="@+id/action_captureSetup_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/captureFragment"
        android:name="com.rommel.scaleprototype.ui.CaptureFragment"
        android:label="@string/title_capture">
        <action
            android:id="@+id/action_capture_to_captureSetup"
            app:destination="@id/captureSetupFragment"
            app:popUpTo="@id/captureSetupFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_capture_to_diagnostic"
            app:destination="@id/bluetoothDiagnosticFragment" />
        <action
            android:id="@+id/action_capture_to_muestreos"
            app:destination="@id/muestreosDiaFragment" />
        <action
            android:id="@+id/action_capture_to_planDia"
            app:destination="@id/planDiaFragment"
            app:popUpTo="@id/planDiaFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_capture_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/bluetoothDiagnosticFragment"
        android:name="com.rommel.scaleprototype.ui.BluetoothDiagnosticFragment"
        android:label="@string/title_diagnostic" />

    <fragment
        android:id="@+id/muestreosDiaFragment"
        android:name="com.rommel.scaleprototype.ui.MuestreosDiaFragment"
        android:label="@string/title_muestreos_dia" />

</navigation>
