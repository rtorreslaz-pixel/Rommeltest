// Prisma schema - App de Inspección de Calidad Avícola

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  VERIFICADOR
  SUPERVISOR
  JEFE
  COMERCIAL
}

enum SexoAve {
  MACHO
  HEMBRA
}

enum CategoriaLesion {
  ALMOHADILLAS
  RASGUNOS
}

enum EstadoInspeccion {
  BORRADOR
  COMPLETA
}

enum GradoHematoma {
  GRADO1
  GRADO2
  GRADO3
}

enum UbicacionHematoma {
  ALA
  ESPINAZO
  PECHUGA
  PIERNA
}

enum CategoriaAve {
  MACHO
  HEMBRA
  MEDIANO
}

enum TipoMuestreo {
  PREVENTA
  CALIDAD // reservado para una fase futura, no usado todavía
}

// Plan diario de muestreo (lo arma el verificador antes de salir a campo).
enum AgrupamientoMuestreo {
  INDIVIDUAL // aves pesadas de una en una
  GRUPAL     // varias aves por pesada
}

enum CircuitoMuestreo {
  CV // circuito vivo
  CB // circuito beneficiado
}

enum EstadoPlanMuestreo {
  PENDIENTE
  HECHO // se marca solo cuando llega el muestreo que coincide con la fila
}

model User {
  id                 String   @id @default(cuid())
  nombre             String
  email              String   @unique
  passwordHash       String
  role               Role     @default(VERIFICADOR)
  activo             Boolean  @default(true)
  apiToken           String?  @unique
  // Obliga a establecer una nueva contraseña en el próximo ingreso (ver login).
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  jornadas              Jornada[]
  inspecciones          Inspeccion[]
  registrosPesoPreventa RegistroPesoPreventa[]
  sacaMuestreos         SacaMuestreo[]
  liveWeightReading     LiveWeightReading?
  sessions              Session[]
  planMuestreo          PlanMuestreoItem[]
}

// Sesión web con token opaco aleatorio (la cookie guarda el token, no el userId),
// para poder revocar sesiones y que expiren de verdad.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Cliente {
  id     String @id @default(cuid())
  nombre String @unique

  // Zona de evaluación del cliente (CD-LIMA / SUR-LIMA). Es atributo del cliente,
  // no del plantel: el filtro del dashboard segmenta por esta.
  zonaEvaluacion String?

  planteles            Plantel[]
  jornadas             Jornada[]
  inspecciones         Inspeccion[]
  apilamientoRegistros ApilamientoRegistro[]
}

model Plantel {
  id             String  @id @default(cuid())
  codigo         String  @unique
  nombre         String?
  zona           String?
  subZona        String?
  tipoPlantel    String?
  zonaEvaluacion String?

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  inspecciones          Inspeccion[]
  registrosPesoPreventa RegistroPesoPreventa[]
  sacaMuestreos         SacaMuestreo[]
  planMuestreo          PlanMuestreoItem[]
}

model TipoDefecto {
  id        String  @id @default(cuid())
  nombre    String  @unique
  categoria String?
  orden     Int     @default(0)
  principal Boolean @default(false)

  registros DefectoRegistro[]
}

model Jornada {
  id     String   @id @default(cuid())
  fecha  DateTime
  anio   Int
  mes    Int
  semana Int

  clienteId     String
  cliente       Cliente @relation(fields: [clienteId], references: [id])
  verificadorId String
  verificador   User    @relation(fields: [verificadorId], references: [id])

  saldos       SaldoDiaAnterior[]
  inspecciones Inspeccion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaldoDiaAnterior {
  id        String  @id @default(cuid())
  jornadaId String
  jornada   Jornada @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  sexo SexoAve

  // Saldo total que dejó el cliente
  unidades Int?
  jabas    Int?
  kg       Float?

  // De ese saldo, lo que el cliente considera selección
  unidadesSeleccion Int?
  jabasSeleccion    Int?
  kgSeleccion       Float?

  // Lo que quedó sin vender tras el beneficiado del saldo
  unidadesRemanente Int?
  jabasRemanente    Int?
  kgRemanente       Float?

  @@unique([jornadaId, sexo])
}

model Inspeccion {
  id String @id @default(cuid())

  jornadaId String?
  jornada   Jornada? @relation(fields: [jornadaId], references: [id])

  // Legacy fields kept for existing rows
  fecha          DateTime?
  anio           Int?
  mes            Int?
  semana         Int?
  campania       String?
  clienteId      String?
  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  verificadorId  String?
  verificador    User?     @relation(fields: [verificadorId], references: [id])
  metaPorcentaje Float     @default(0.6)

  plantelId String?
  plantel   Plantel? @relation(fields: [plantelId], references: [id])

  galpon   String?
  corral   String?
  sexo     SexoAve?
  jabas    Int?
  cantidad Int      @default(0)

  promVivo        Float?
  promBeneficiado Float?

  nroGuia       String?
  complex       String?
  observaciones String?

  tempPlataforma      Float?
  tempPlataformaVacia Float?
  tempCamion          Float?
  tempAves            Float?
  densidad            Float?

  hematomasCon Int?
  hematomasSin Int?

  pigNivel0 Int @default(0)
  pigNivel1 Int @default(0)
  pigNivel2 Int @default(0)
  pigNivel3 Int @default(0)
  pigNivel4 Int @default(0)
  pigNivel5 Int @default(0)
  pigNivel6 Int @default(0)
  pigNivel7 Int @default(0)

  mermaAlaKg    Float?
  mermaPiernaKg Float?

  estado     EstadoInspeccion @default(BORRADOR)
  pasoActual Int              @default(1)

  // true cuando el registro solo trae datos de pododermatitis/rasguños o pigmentación
  // (sin censo de selección/merma); se excluye de esos ratios para no diluirlos.
  soloLesionPigmentacion Boolean @default(false)

  defectos           DefectoRegistro[]
  fotos              Foto[]
  evaluacionesLesion EvaluacionLesion[]
  hematomaDetalles   HematomaDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DefectoRegistro {
  id String @id @default(cuid())

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  tipoDefectoId String
  tipoDefecto   TipoDefecto @relation(fields: [tipoDefectoId], references: [id])

  unidades Int   @default(0)
  kg       Float @default(0)

  @@unique([inspeccionId, tipoDefectoId])
}

model Foto {
  id String @id @default(cuid())

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  path        String
  descripcion String?
  latitud     Float?
  longitud    Float?

  createdAt DateTime @default(now())
}

model HematomaDetalle {
  id String @id @default(cuid())

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  grado     GradoHematoma
  ubicacion UbicacionHematoma

  cantidad Int @default(0)

  @@unique([inspeccionId, grado, ubicacion])
}

model EvaluacionLesion {
  id String @id @default(cuid())

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  categoria CategoriaLesion
  sexo      SexoAve

  muestra   Int @default(0)
  sinLesion Int @default(0)
  leve      Int @default(0)
  grave     Int @default(0)

  @@unique([inspeccionId, categoria, sexo])
}

model RegistroPesoPreventa {
  // Id generado por el cliente Android (UUID v4) ANTES de sincronizar, para que
  // reintentos de red produzcan upserts idempotentes en vez de duplicados.
  // NO cambiar a @default(cuid()) -- ver POST /api/mobile/registros.
  id String @id

  plantelId String
  plantel   Plantel @relation(fields: [plantelId], references: [id])

  campania  String?
  galpon    String
  corral    String
  categoria CategoriaAve

  numeroAve  Int
  pesoGramos Float? // null en muestreos de solo calidad (sin pesaje)
  fechaHora  DateTime // momento de captura en campo (hora del celular), no de sync

  // Plantel-Campaña-Galpón-Categoría-Corral, mismo formato que Inspeccion.complex,
  // para cruzar peso de preventa contra evaluaciones de calidad del mismo lote.
  complex String?

  tipoMuestreo TipoMuestreo @default(PREVENTA)

  // Criterios de calidad evaluados opcionalmente sobre la misma ave pesada, en la misma
  // pantalla de captura (no todas las aves se evalúan -- el chequeo de calidad toma más
  // tiempo que pesar sola, así que el verificador lo activa solo para una sub-muestra).
  // Mismos criterios que Inspeccion.{hematomasCon/Sin, defectos, evaluacionesLesion,
  // pigNivel*} pero a nivel de ave individual en granja, para poder comparar contra el
  // censo de calidad de cliente lote por lote.
  // Metadatos del lote al momento de la pesada
  edad          Int?    // días de vida del lote
  linea         String? // línea genética (ej. Ross, Cobb)
  lote          String? // J (Joven) / A (Adulto)
  nAvesPorPesada Int?   // N° aves pesadas juntas por lectura de báscula

  tieneHematoma         Boolean?
  tieneDefectoSeleccion Boolean?
  gradoPododermatitis   Int? // 0 sin lesión, 1 leve, 2 grave (grave = Grado 2, igual que EvaluacionLesion.grave)
  gradoRasguno          Int? // 0 sin lesión, 1 leve, 2 grave
  pigmentacion          Int? // 0-7

  verificadorId String
  verificador   User @relation(fields: [verificadorId], references: [id])

  syncedAt  DateTime @default(now()) // momento en que el servidor lo recibió
  createdAt DateTime @default(now())

  @@index([plantelId, galpon, corral, categoria])
  @@index([verificadorId, fechaHora])
}

// Tabla de pesos estándar por raza, sexo y edad. Se incluye en GET /api/mobile/catalogos
// para que la app compare el peso en vivo contra el estándar sin llamadas adicionales.
// Poblar con los datos de la hoja STD del Excel del cliente.
// Muestreo de jabas que hace el equipo de saca ANTES de la saca diaria (~40+ días), a
// diferencia del muestreo de preventa (~35 días, aves individuales). No se pesa el galpón
// completo: se muestrean algunas jabas y de ahí sale el peso promedio por ave.
// Se ata al mismo lote que preventa por complexLote (Plantel-Campaña-Galpón-Categoría),
// que es el complex de preventa SIN el corral, para poder comparar estimado vs real.
model SacaMuestreo {
  // Id generado por el cliente Android (UUID v4) antes de sincronizar -> upsert idempotente.
  id String @id

  plantelId String
  plantel   Plantel @relation(fields: [plantelId], references: [id])

  campania  String?
  galpon    String
  corral    String? // "lado" del galpón (A/B/C/D), igual que en preventa
  categoria CategoriaAve

  // Dos claves de cruce con preventa:
  //  - complex: Plantel-Campaña-Galpón-Categoría-Corral, idéntico al de preventa (cruce exacto).
  //  - complexLote: el mismo sin el corral, para cuando la saca y la preventa no coinciden de lado.
  complex     String?
  complexLote String?

  fecha DateTime // momento del muestreo en campo (hora del celular)
  edad  Int? // días de vida del lote al momento de la saca (~40+)

  // Parámetros del muestreo: se establecen una vez y valen para todas las pesadas.
  avesPorJaba       Int
  taraGramosPorJaba Float
  tipoJaba          String? // etiqueta opcional del tipo de jaba

  verificadorId String
  verificador   User @relation(fields: [verificadorId], references: [id])

  pesadas SacaPesada[]

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([plantelId, galpon, categoria])
  @@index([complex])
  @@index([complexLote])
  @@index([verificadorId, fecha])
}

// Cada pesada = varias jabas puestas juntas en la balanza. El neto descuenta la tara de
// las jabas; el promedio por ave sale de dividir el neto entre las aves de esas jabas.
model SacaPesada {
  id String @id

  sacaMuestreoId String
  sacaMuestreo   SacaMuestreo @relation(fields: [sacaMuestreoId], references: [id], onDelete: Cascade)

  numJabas        Int
  pesoBrutoGramos Float // lo que marcó la balanza
  pesoNetoGramos  Float // bruto - tara*numJabas (calculado al registrar)
  avesTotal       Int // numJabas * avesPorJaba
  promedioGramos  Float // pesoNetoGramos / avesTotal

  fechaHora DateTime
  createdAt DateTime @default(now())

  @@index([sacaMuestreoId])
}

// ---------------------------------------------------------------------------------------
// Módulo de Verificación de Apilamiento y Ventilación de Jabas (instructivo IICYB003).
// El verificador registra en el local del cliente el cumplimiento de 8 ítems (APV-01..08),
// con observaciones y evidencia (fotos y videos cortos), y las acciones correctivas de los
// incumplimientos. El registro se hace desde un enlace con token (sin sesión); la consulta
// y el reporte se hacen con login.
// ---------------------------------------------------------------------------------------

enum ApilamientoBloque {
  DESCARGA
  APILAMIENTO
  VENTILACION
}

enum ApilamientoResultado {
  C // Conforme
  NC // No conforme
  NA // No aplica (solo APV-01, exige observación)
  VN // Ventilación natural (ítems del ventilador APV-05..07)
}

enum TipoVentilacion {
  MECANICA
  NATURAL
}

enum EstadoApilamiento {
  BORRADOR
  FINALIZADO
}

enum SemaforoApilamiento {
  VERDE
  AMBAR
  ROJO
  NA // sin ítems evaluables
}

enum EstadoAccionApilamiento {
  PENDIENTE
  CERRADA
}

enum TipoMediaApilamiento {
  FOTO
  VIDEO
}

// Catálogo maestro de los 8 ítems (seed). Versionable con `activo` sin borrar histórico.
model ApilamientoItem {
  codigo                String            @id // APV-01 .. APV-08
  bloque                ApilamientoBloque
  orden                 Int
  descripcion           String
  referenciaInstructivo String? // ítem del IICYB003 (2.1 .. 2.8)
  permiteNa             Boolean           @default(false)
  permiteVn             Boolean           @default(false)
  activo                Boolean           @default(true)

  detalles ApilamientoDetalle[]
  acciones ApilamientoAccion[]
}

model ApilamientoRegistro {
  id             String @id // UUID generado en el cliente
  codigoRegistro String @unique // APV-{AAAA}-{secuencia 5 dígitos}

  fechaEvaluacion DateTime // no se admite fecha futura (validado en la API)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  // La evaluación es POR LOCAL del cliente: el local es la unidad evaluada, no un dato
  // opcional. No se registran datos del despacho del día (placa, jabas, lote): no son
  // relevantes para evaluar las condiciones del local.
  local     String

  // Con el enlace público no hay sesión: el verificador se identifica por nombre.
  verificadorNombre String

  tipoVentilacion      TipoVentilacion
  cantidadVentiladores Int? // obligatorio >= 1 si MECANICA, nulo si NATURAL

  // Calculados al guardar (ver lib/apilamiento.ts)
  itemsConformes         Int                 @default(0)
  itemsNoConformes       Int                 @default(0)
  itemsNa                Int                 @default(0)
  itemsVn                Int                 @default(0)
  porcentajeCumplimiento Float? // null si no hay ítems evaluables
  semaforo               SemaforoApilamiento @default(NA)
  // RN-07: APV-08 en NC es hallazgo crítico (riesgo de asfixia) y fuerza semáforo ROJO.
  hallazgoCritico        Boolean             @default(false)

  estado                 EstadoApilamiento @default(FINALIZADO)
  observacionesGenerales String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalles ApilamientoDetalle[]
  acciones ApilamientoAccion[]
  medias   ApilamientoMedia[]

  // RN-08: una evaluación por local y por día (antes era por despacho/placa).
  @@unique([clienteId, local, fechaEvaluacion])
  @@index([fechaEvaluacion])
  @@index([semaforo])
}

model ApilamientoDetalle {
  id String @id @default(cuid())

  registroId String
  registro   ApilamientoRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  itemCodigo String
  item       ApilamientoItem @relation(fields: [itemCodigo], references: [codigo])

  resultado   ApilamientoResultado
  observacion String? // obligatoria si NC o NA (mín. 10 caracteres)

  medias ApilamientoMedia[]

  @@unique([registroId, itemCodigo])
}

// Evidencia: fotos (recomprimidas) y videos cortos. Se sirven por /api/uploads/... con login.
model ApilamientoMedia {
  id String @id @default(cuid())

  registroId String
  registro   ApilamientoRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  detalleId String?
  detalle   ApilamientoDetalle? @relation(fields: [detalleId], references: [id], onDelete: Cascade)

  // Ítem al que corresponde la evidencia. Null = evidencia general del local (por ejemplo la
  // foto o el video de la ventilación, que no pertenece a un ítem del checklist).
  itemCodigo String?
  tipo       TipoMediaApilamiento
  path       String
  bytes      Int?

  createdAt DateTime @default(now())

  @@index([registroId])
}

model ApilamientoAccion {
  id String @id @default(cuid())

  registroId String
  registro   ApilamientoRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  itemCodigo String // debe corresponder a un ítem con resultado NC (RN-03)
  item       ApilamientoItem @relation(fields: [itemCodigo], references: [codigo])

  descripcion     String
  responsable     String
  fechaCompromiso DateTime

  estado             EstadoAccionApilamiento @default(PENDIENTE)
  fechaCierre        DateTime?
  evidenciaCierreUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registroId])
  @@index([estado, fechaCompromiso])
}

model PesoEstandar {
  id         String  @id @default(cuid())
  linea      String  // "Ross", "Cobb", "Hubbard", etc.
  sexo       SexoAve // MACHO | HEMBRA
  edadDias   Int
  pesoGramos Float

  @@unique([linea, sexo, edadDias])
  @@index([linea, sexo])
}

// Última lectura de la báscula por verificador, sobrescrita en cada lectura
// (no es historial -- el historial real son los RegistroPesoPreventa). Alimenta
// el panel "Peso en vivo" del dashboard.
model LiveWeightReading {
  verificadorId String @id
  verificador   User   @relation(fields: [verificadorId], references: [id])

  pesoGramos Float

  plantelCodigo String?
  campania      String?
  galpon        String?
  corral        String?
  categoria     CategoriaAve?
  complex       String?

  updatedAt DateTime @updatedAt
}

// Una fila del plan diario del verificador: qué corral va a muestrear, con qué parámetros. La
// crea la app (offline) con un id UUID propio y se sincroniza; el estado pasa a HECHO solo cuando
// llega un muestreo del mismo verificador, día, plantel, galpón, corral, sexo y tipo.
model PlanMuestreoItem {
  id String @id

  verificadorId String
  verificador   User @relation(fields: [verificadorId], references: [id])

  // Día del plan en hora de la granja (yyyy-MM-dd). Texto a propósito: no depende de zona horaria.
  fecha String

  plantelId String
  plantel   Plantel @relation(fields: [plantelId], references: [id])

  campania     String
  galpon       String
  corral       String
  categoria    CategoriaAve
  edad         Int?
  tipoMuestreo TipoMuestreo         @default(PREVENTA)
  linea        String?
  lote         String?
  agrupamiento AgrupamientoMuestreo @default(INDIVIDUAL)
  // Cuántas aves van juntas en cada pesada cuando el agrupamiento es GRUPAL (null = individual).
  avesPorPesada Int?
  circuito     CircuitoMuestreo?
  // Orden dentro del día, para listar el plan como lo armó el verificador.
  orden Int @default(0)

  estado     EstadoPlanMuestreo @default(PENDIENTE)
  cumplidoEn DateTime?

  // Misma clave que RegistroPesoPreventa.complex, para cruzar y para reportar.
  complex String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificadorId, fecha])
  @@index([plantelId, fecha])
}
